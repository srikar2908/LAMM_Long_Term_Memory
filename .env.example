# LLM Configuration (Optional - leave empty for offline mock mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Embeddings: 'sentence_transformer' or 'hash' (offline deterministic)
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Storage & FAISS Vector Index
DATABASE_URL=sqlite:///storage/lamm.db
FAISS_INDEX_PATH=storage/vector_index

# Retrieval Settings
TOP_K=5

# LAMM Lifecycle Scoring Weights (Must be non-negative)
RELEVANCE_WEIGHT=0.30
RECENCY_WEIGHT=0.15
CONFIDENCE_WEIGHT=0.20
REDUNDANCY_WEIGHT=0.25
UTILITY_WEIGHT=0.10

# LAMM Lifecycle Thresholds (Must satisfy: 0 <= FORGET <= ARCHIVE <= 1.0)
REDUNDANCY_THRESHOLD=0.86
ARCHIVE_THRESHOLD=0.32
FORGET_THRESHOLD=0.18

# Recency Exponential Decay Constant (lambda in exp(-lambda * age_days))
RECENCY_DECAY=0.03

# Compression & Resource Constraints
COMPRESS_LENGTH=180
MAX_ACTIVE_MEMORIES=100
RECENCY_BASELINE_BUDGET=5

# Modes & Reproducibility
LAMM_DRY_RUN=false
RANDOM_SEED=42
